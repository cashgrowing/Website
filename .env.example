# ---------------------------------------------------------------------------
# Copy nothing from here into chat or into git. Real values live only in the
# Vercel project settings (Settings -> Environment Variables).
# ---------------------------------------------------------------------------

# Public site origin, used for canonicals, sitemap and JSON-LD @id values.
NEXT_PUBLIC_SITE_URL="https://www.wildrootscr.com"

# Hostaway (OAuth 2.0 client credentials). Server-only: never prefix NEXT_PUBLIC_.
#
# HOSTAWAY_ACCOUNT_ID is the ID of the API KEY, from the ID column of
# Settings -> Hostaway API. It is NOT the Hostaway account number. Each key has
# its own ID, and the wrong pairing returns 401 invalid_client, which is
# indistinguishable from a bad key.
HOSTAWAY_ACCOUNT_ID=""
HOSTAWAY_API_KEY=""

# Hostaway booking engine handoff (checkout is NOT iframed).
NEXT_PUBLIC_BOOKING_ENGINE_URL="https://book.wildrootscr.com"

# --- Sanity (the CMS) -------------------------------------------------------
# The site reads content from Sanity and falls back to the copy committed in
# src/content if Sanity is unreachable or a document fails validation. The
# project id is not a secret; the read token only matters for a private dataset.
SANITY_PROJECT_ID="6pybhi99"
SANITY_DATASET="production"
# Only needed if the dataset is made private. It is public today,
# so the site reads it without a token.
SANITY_API_READ_TOKEN=""

# --- Phase 2 ---------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# CLICKUP_API_TOKEN=""
# CLICKUP_LEADS_LIST_ID=""
# HOSTAWAY_WEBHOOK_SECRET=""

# --- Enquiry form (Phase 2) -------------------------------------------------
# The browser never talks to Supabase: submissions go to /api/inquiries, which
# writes server-side with the service role key. Run supabase/schema.sql once in
# the Supabase SQL editor before switching these on.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Turnstile. The form is hidden and the endpoint refuses writes
# until both of these are set - an unprotected public write endpoint is worse
# than no form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Any random string. Salts the stored hash of a submitter's IP so the raw
# address is never written down. Leave empty and no hash is stored at all.
INQUIRY_IP_SALT=""

# Optional: every owner lead also becomes a ClickUp task. Best effort - the
# enquiry is already saved in Supabase before this runs.
CLICKUP_API_TOKEN=""
CLICKUP_LEADS_LIST_ID=""

# --- Analytics --------------------------------------------------------------
# Nothing loads, and no consent banner appears, until one of these is set.
# Tags mount only after a visitor agrees, so first paint stays free of them.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
