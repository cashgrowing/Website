{
  "name": "wildroots",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "eslint . && node --test tests/ && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:only": "next build",
    "sanity:export": "node scripts/export-sanity.ts",
    "sanity:check": "node scripts/export-sanity.ts && node scripts/check-sanity-roundtrip.ts",
    "test": "node --test tests/",
    "backup": "node scripts/backup.ts ./backup"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.8.0"
  }
}
